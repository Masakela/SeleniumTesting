<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  The suite file Surefire runs. Two things worth pointing out in an interview:
    parallel="methods" + thread-count  -> run tests concurrently for speed
    <parameter name="browser">         -> feeds BaseTest.setUp for cross-browser
  Parallelism only works because each test gets its own driver (see @BeforeMethod)
  and shares no state — isolation is the prerequisite for going parallel.
-->
<suite name="LoginSuite">
    <listeners>
        <listener class-name="com.example.listeners.TestListener"/>
    </listeners>
    <test name="LoginOnly">
        <classes>
            <class name="com.example.tests.LoginTest"/>
        </classes>
    </test>
</suite>
